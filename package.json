{
  "name": "ddeasy",
  "version": "0.5.2.5",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --turbopack",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "build:srd-spells": "node scripts/build-srd-spells.mjs",
    "build:srd-spell-index": "node scripts/build-srd-spell-index.mjs",
    "build:srd-document": "node scripts/build-srd-document.mjs",
    "build:srd": "node scripts/build-srd-spells.mjs && node scripts/build-srd-document.mjs",
    "consolidate:srd-rules": "node scripts/consolidate-srd-rules.mjs",
    "consolidate:srd-macro": "node node_modules/tsx/dist/cli.mjs scripts/consolidate-srd-macro.ts",
    "build:macro-srd": "node node_modules/tsx/dist/cli.mjs scripts/buildMacroSrd.ts",
    "compile:perfect-srd": "node node_modules/tsx/dist/cli.mjs scripts/compilePerfectSrd.ts",
    "purge:segmented-srd": "node node_modules/tsx/dist/cli.mjs scripts/purgeSegmentedFiles.ts",
    "parse:srd-pdf": "node node_modules/tsx/dist/cli.mjs scripts/parseSrdPdf.ts",
    "generate:theme-art": "node scripts/generate-theme-art.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
