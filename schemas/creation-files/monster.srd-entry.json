{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddeasy.app/schemas/creation-files/monster.srd-entry.json",
  "title": "monster.srd-entry — Bundled SRD monster stat block",
  "description": "Virtual read-only row from src/lib/srd/corpus.ts",
  "type": "object",
  "required": ["id", "ciClass", "name", "kind", "key"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/srdEntityId" },
    "ciClass": { "const": "monster.srd-entry" },
    "name": { "type": "string" },
    "kind": { "const": "monster" },
    "key": { "type": "string" },
    "chapter": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "provenance": { "const": "srd" }
  },
  "additionalProperties": false
}
