{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddeasy.app/schemas/creation-files/session.tabletop.json",
  "title": "session.tabletop — Live Virtual Table session (TabletopSession subset)",
  "description": "Live table state in src/lib/tabletop/store.ts — not in library backup.",
  "type": "object",
  "required": ["version", "updatedAt"],
  "properties": {
    "version": { "const": 1 },
    "updatedAt": { "$ref": "common.json#/$defs/isoDateTime" },
    "activePartyId": { "type": ["string", "null"] },
    "mapName": { "type": "string" },
    "cfMetadata": { "$ref": "common.json#/$defs/cfMetadata" }
  },
  "additionalProperties": true
}
