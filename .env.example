# Required for text generation (adventure, realm, characters)
ANTHROPIC_API_KEY=

# Required for map, prop, realm cartography, and scene theme banner/sign art (npm run generate:theme-art)
OPENAI_API_KEY=

# Optional: override default OpenAI image model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: gpt-image-* only — "low" (app default) vs "auto" (stricter input moderation)
# OPENAI_IMAGE_MODERATION=auto

# Optional: preferred Claude model; falls back automatically if unavailable
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional API protection (see src/middleware.ts)
# MAX_API_BODY_BYTES=2000000
# API_RATE_LIMIT_MAX=60
# API_RATE_LIMIT_WINDOW_MS=60000

# ---- Local auth (development / alpha testing) --------------------------------
# Required in production for DM sign-in. Generate a long random string.
# AUTH_SECRET=change-me-in-production

# Sandbox test accounts (admin@dmms.test, dm1@dmms.test, dm2@dmms.test) are enabled
# only when NODE_ENV=development. Set AUTH_SANDBOX=false to disable even in dev.
# AUTH_SANDBOX=false

# Shared password for all sandbox accounts (default: alpha-test)
# AUTH_SANDBOX_PASSWORD=alpha-test

# Legacy env-admin bootstrap (optional, separate from sandbox accounts)
# DM_AUTH_USERNAME=admin
# DM_AUTH_PASSWORD=
# DM_AUTH_SECRET=

# ---- Session room relay (serverless) -----------------------------------------
# Without these, session rooms use in-process memory (fine for local `next dev`).
# For Vercel / multi-instance: create an Upstash Redis database (or Vercel KV) and set:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=
# Aliases also accepted: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Rooms expire after 8 hours (Redis key TTL + expiresAt).
